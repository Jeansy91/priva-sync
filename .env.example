# Kopiere diese Datei zu .env und befuelle die Werte

# ── Pflicht ──────────────────────────────────────────────────────────────────
# Datenbank-Passwort (min. 20 Zeichen)
DB_PASSWORD=changeme

# JWT-Secret (min. 32 Zeichen, zufaellig generieren: openssl rand -hex 32)
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# ── Server (optional, haben Defaults) ────────────────────────────────────────
# Oeffentliche URL unter der der Server erreichbar ist
# BASE_URL=https://priva-sync.example.com

# Komma-separierte Liste erlaubter CORS-Origins
# CORS_ORIGINS=https://priva-sync.example.com

# Komma-separierte Netze, deren X-Forwarded-For/X-Real-IP geglaubt wird.
# Leer (Default) = kein Header wird geglaubt, es zählt die TCP-Peer-Adresse.
# Hinter einem Reverse-Proxy zwingend auf dessen Netz setzen, sonst sehen
# Rate-Limit, Login-Lockout und Audit-Log alle Nutzer als eine einzige IP.
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Upload-Limit in MB (Default 10240 = 10 GB)
# MAX_UPLOAD_SIZE_MB=10240

# ── Auth-TTLs (optional) ─────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# TWO_FA_SESSION_TTL=5m
# MAX_LOGIN_ATTEMPTS=20
# LOGIN_LOCKOUT_WINDOW=1m

# ── Sync (optional) ──────────────────────────────────────────────────────────
# DELTA_THRESHOLD_MB=1
# BLOCK_SIZE_MB=1

# ── Office-Vorschau (optional, ADR-0027) ─────────────────────────────────────
# Externer OnlyOffice-/Euro-Office-Document-Server. Beide leer = Feature aus.
# DOCUMENT_SERVER_URL=https://onlyoffice.example.com
# DOCUMENT_SERVER_JWT_SECRET=changeme_shared_with_document_server

# ── SMTP (optional — SMTP_ENABLED=true zum Aktivieren) ───────────────────────
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=changeme
# SMTP_FROM_NAME=PrivaSync
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_TLS_MODE=starttls   # none | starttls | tls
