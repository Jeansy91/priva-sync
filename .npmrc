# Automated environments (CI, agent harness) have no TTY to answer pnpm's
# interactive "purge node_modules?" prompt, which aborts install with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY whenever workspace config
# changes invalidate the existing node_modules layout. Skip the prompt and
# let pnpm purge automatically instead.
confirmModulesPurge=false

# Same 7-day quarantine as pnpm-workspace.yaml's minimumReleaseAge, mirrored
# here for tools (e.g. semgrep's npm-missing-minimum-release-age rule) that
# only look at the native npm config key and don't know this is a pnpm repo.
min-release-age=7
