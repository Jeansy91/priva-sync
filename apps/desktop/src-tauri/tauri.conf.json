{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "PrivaSync",
  "version": "0.17.0",
  "identifier": "io.github.jeansy91.privasync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && node scripts/build-shell.mjs && node scripts/build-sparse-package.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PrivaSync",
        "width": 960,
        "height": 680,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "PrivaSync",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["privasync"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCODk5MzNDM0ZEOTIxNUMKUldSY0lkay9QSk9KeXh6UzFTOUppRVBrZ1Bua3VCNVUzWkFoM2lMd1FCa2JCbmxpNUpKekNrclkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
